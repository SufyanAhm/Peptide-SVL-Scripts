#svl
global function main []
    local db_path = 'ACKR4/ACKR4_pliffilteredset_results.mdb';
    local mol_field = 'mol';
    local name_field = 'name';

    local db = db_Open [db_path, 'read-write'];
    local entries = db_Entries db;
    local entry;
    local idx = 0;

    for entry in entries loop
        idx = idx + 1;

        local mol_data = first db_ReadFields [db, entry, mol_field];
        local raw_name = first db_ReadFields [db, entry, name_field];
        local clean_name = twrite ['{}', raw_name];

        Close [force: 1];
        _moe_Create [mol_data, [selection:1, sets:1, view:1]];
        local c = Chains[];

        cSetName [c, [clean_name]];

        local renamed_mol = _moe_Extract [Chains[], [], [selection:1, sets:1, view:1]];
        db_Write [db, entry, [mol: renamed_mol]];   // field name hardcoded, not via variable

        Close [force: 1];
        print twrite ['Entry {} renamed to {}.', idx, clean_name];
    endloop

    db_Close db;
    print 'Done.';
endfunction
