#svl
global function main []
    local chains = Chains[];
    local f = fopenw 'output_txt.txt';
    local ci;
    for ci = 1, length chains loop
        local res = Residues chains(ci);
        local names = apt rName res;
        local nums = apt rUID res;
        write ['Chain {}\n', cName chains(ci)];
        fwrite [f, 'Chain {}\n', cName chains(ci)];
        local ri;
        for ri = 1, length names loop
            fwrite [f, '{},{}\n', nums(ri), names(ri)];
        endloop
    endloop
    fclose f;
    write ['Done'];
endfunction
